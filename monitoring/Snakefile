"""
Pipeline for reproducing the scDblFinderPy paper's Python benchmark and
comparison figure, split by CPU vs. GPU run, with resource usage tracked
for each.

Lives in monitoring/ alongside gpu_monitor.py, but all rule paths are
written relative to the repo root (scDblFinderPy_paper/), which the
`workdir:` below pins to regardless of where you invoke `snakemake` from.

Run everything (from either this directory or the repo root):
    snakemake --cores 1 -s monitoring/Snakefile   # from repo root
    snakemake --cores 1                           # from monitoring/

Run just one target (Snakemake figures out which upstream rules it needs):
    snakemake --cores 1 benchmarking/benchmark_AUPRC_fig_GPU.png

See a dry run (what would execute, without executing it):
    snakemake -n
"""

import glob
from pathlib import Path

# workflow.basedir is always this Snakefile's own directory (monitoring/),
# no matter where `snakemake` is invoked from - so this pins all relative
# paths below to the repo root reliably.
workdir: str(Path(workflow.basedir).parent)

RDS_FILES = glob.glob("benchmarking/datasets/*.rds")
H5AD_FILES = [f.replace(".rds", ".h5ad") for f in RDS_FILES]


rule all:
    input:
        "benchmarking/benchmark_AUPRC_fig_CPU.png",
        "benchmarking/benchmark_AUPRC_fig_GPU.png",
        "monitoring/benchmarks/run_benchmark_CPU.tsv",
        "monitoring/benchmarks/run_benchmark_GPU.tsv",
        "monitoring/benchmarks/gpu_usage_GPU.csv",
        "monitoring/benchmarks/run_scrublet_benchmark.tsv",
        "monitoring/benchmarks/run_vaeda_benchmark.tsv",
        "monitoring/benchmarks/run_r_benchmark.tsv",


# Converts the raw .rds datasets to the .h5ad format run_python_benchmark.py
# reads. One R script call produces every .h5ad, so this is one rule with
# many outputs rather than one rule per file.
rule convert_datasets:
    input:
        rds=RDS_FILES,
        script="benchmarking/datasets/convert_rds_to_h5ad.R",
    output:
        H5AD_FILES,
    shell:
        "cd benchmarking/datasets && Rscript convert_rds_to_h5ad.R"


rule run_benchmark_cpu:
    input:
        script="benchmarking/run_python_benchmark.py",
        datasets=H5AD_FILES,
    output:
        csv="benchmarking/python_benchmark_metrics_CPU.csv",
    benchmark:
        # Snakemake auto-fills this with wall time, max RSS, mean CPU load, etc.
        "monitoring/benchmarks/run_benchmark_CPU.tsv"
    shell:
        "python {input.script}"


rule run_benchmark_gpu:
    input:
        script="benchmarking/run_python_benchmark.py",
        datasets=H5AD_FILES,
    output:
        csv="benchmarking/python_benchmark_metrics_GPU.csv",
        gpu_log="monitoring/benchmarks/gpu_usage_GPU.csv",
    benchmark:
        "monitoring/benchmarks/run_benchmark_GPU.tsv"
    params:
        interval=1,
    shell:
        """
        python monitoring/gpu_monitor.py {output.gpu_log} {params.interval} &
        monitor_pid=$!
        trap 'kill $monitor_pid 2>/dev/null' EXIT
        python {input.script} --gpu
        """

# Scrublet moved to run_scrublet_benchmark.py since it's 
# a Python package
rule run_scrublet_benchmark:
    input:
        script="benchmarking/run_scrublet_benchmark.py",
        datasets=H5AD_FILES,
    output:
        csv="benchmarking/scrublet_benchmark_metrics.csv",
    benchmark:
        "monitoring/benchmarks/run_scrublet_benchmark.tsv"
    shell:
        "python {input.script}"


# vaeda pins very old deps (Python 3.8, TensorFlow 2.8) that conflict with
# the main env used for run_python_benchmark.py/run_scrublet_benchmark.py,
# so it lives in its own conda env (vaeda_env) invoked by absolute path -
# `conda run -n vaeda_env` was unreliable on this host (silently fell back
# to a different env's python).
rule run_vaeda_benchmark:
    input:
        script="benchmarking/run_vaeda_benchmark.py",
        datasets=H5AD_FILES,
    output:
        csv="benchmarking/vaeda_benchmark_metrics.csv",
    benchmark:
        "monitoring/benchmarks/run_vaeda_benchmark.tsv"
    shell:
        "/home/ahiropedi/.conda/envs/vaeda_env/bin/python {input.script}"


# Recomputes DoubletFinder (default) with its current version; carries over
# every other R-native method from benchmark.results_R.rds's own last run
# rather than any static paper-era file (the R script reads its own output
# if present - marked update() below so Snakemake doesn't delete it first -
# and starts from an empty baseline otherwise). The very first invocation
# should therefore use --all so nothing is missing afterwards. Pass
# --config rerun_methods=... to also rerun any of scDblFinder.clusters,
# scDblFinder.random, bcds, cxds, hybrid, computeDoubletDensity - either a
# comma-separated subset or "all", e.g.:
#   snakemake --cores 1 --config rerun_methods=all
#   snakemake --cores 1 --config rerun_methods=bcds,cxds
rule run_r_benchmark:
    input:
        script="benchmarking/run_r_benchmark.R",
        datasets=RDS_FILES,
    output:
        rds=update("benchmarking/benchmark.results_R.rds"),
    benchmark:
        "monitoring/benchmarks/run_r_benchmark.tsv"
    params:
        methods_arg=lambda wc: (
            "--all" if config.get("rerun_methods") == "all"
            else config.get("rerun_methods", "")
        ),
    shell:
        "cd benchmarking && Rscript run_r_benchmark.R {params.methods_arg}"


rule plot:
    input:
        csv="benchmarking/python_benchmark_metrics_{mode}.csv",
        scrublet_csv="benchmarking/scrublet_benchmark_metrics.csv",
        vaeda_csv="benchmarking/vaeda_benchmark_metrics.csv",
        rds="benchmarking/benchmark.results_R.rds",
        script="benchmarking/plot_benchmark.R",
    output:
        "benchmarking/benchmark_AUPRC_fig_{mode}.png",
    params:
        gpu_flag=lambda wc: "--gpu" if wc.mode == "GPU" else "",
    shell:
        "cd benchmarking && Rscript plot_benchmark.R {params.gpu_flag}"
